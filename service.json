{
  "$schema": "https://service-lasso.dev/schemas/service.schema.json",
  "id": "cacao-roaster",
  "name": "CACAO Roaster",
  "description": "Release-backed CACAO Roaster web UI for authoring CACAO playbooks and pairing with SOARCA.",
  "version": "1.3.0",
  "enabled": false,
  "ports": {
    "service": 3000
  },
  "portmapping": {
    "http": "${SERVICE_PORT}"
  },
  "env": {
    "NODE_ENV": "production",
    "PORT": "${SERVICE_PORT}",
    "CACAO_ROASTER_HOST": "127.0.0.1",
    "CACAO_ROASTER_PORT": "${SERVICE_PORT}",
    "CACAO_ROASTER_URL": "http://127.0.0.1:${SERVICE_PORT}",
    "SOARCA_END_POINT": "${SOARCA_URL}"
  },
  "globalenv": {
    "CACAO_ROASTER_URL": "${CACAO_ROASTER_URL}",
    "CACAO_ROASTER_PORT": "${SERVICE_PORT}"
  },
  "urls": [
    {
      "label": "CACAO Roaster UI",
      "url": "${CACAO_ROASTER_URL}",
      "kind": "local"
    },
    {
      "label": "health",
      "url": "${CACAO_ROASTER_URL}/healthcheck",
      "kind": "local"
    }
  ],
  "artifact": {
    "kind": "archive",
    "source": {
      "type": "github-release",
      "repo": "service-lasso/lasso-cacao-roaster",
      "channel": "latest"
    },
    "platforms": {
      "win32": {
        "assetName": "lasso-cacao-roaster-1.3.0-win32.zip",
        "archiveType": "zip",
        "command": "./server.mjs",
        "args": []
      },
      "linux": {
        "assetName": "lasso-cacao-roaster-1.3.0-linux.tar.gz",
        "archiveType": "tar.gz",
        "command": "./server.mjs",
        "args": []
      },
      "darwin": {
        "assetName": "lasso-cacao-roaster-1.3.0-darwin.tar.gz",
        "archiveType": "tar.gz",
        "command": "./server.mjs",
        "args": []
      }
    }
  },
  "install": {
    "files": [
      {
        "path": "./runtime/.keep",
        "content": ""
      },
      {
        "path": "./logs/.keep",
        "content": ""
      }
    ]
  },
  "depend_on": [
    "@node",
    "soarca"
  ],
  "execservice": "@node",
  "commandline": {
    "win32": "${SERVICE_ARTIFACT_ROOT}/server.mjs",
    "linux": "${SERVICE_ARTIFACT_ROOT}/server.mjs",
    "darwin": "${SERVICE_ARTIFACT_ROOT}/server.mjs",
    "default": "${SERVICE_ARTIFACT_ROOT}/server.mjs"
  },
  "healthcheck": {
    "type": "http",
    "url": "${CACAO_ROASTER_URL}/healthcheck",
    "expected_status": 200,
    "retries": 180,
    "interval": 500
  },
  "updates": {
    "enabled": true,
    "mode": "notify",
    "track": "latest",
    "checkIntervalSeconds": 86400
  },
  "meta": {
    "repository": {
      "type": "git",
      "url": "https://github.com/service-lasso/lasso-cacao-roaster.git"
    },
    "documentationUrl": "https://github.com/service-lasso/lasso-cacao-roaster/blob/main/README.md",
    "issuesUrl": "https://github.com/service-lasso/lasso-cacao-roaster/issues",
    "upstreamUrl": "https://github.com/opencybersecurityalliance/cacao-roaster",
    "tags": [
      "service-lasso",
      "cacao",
      "cacao-roaster",
      "soarca",
      "playbooks",
      "web-ui"
    ]
  }
}
